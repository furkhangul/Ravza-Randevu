    "sand": { "$value": "#F8F5F0", "$type": "color" },
    "mutedGold": { "$value": "#C9A86A", "$type": "color" },
    "ink": { "$value": "#14261D", "$type": "color" },
    "success": { "$value": "#19613F", "$type": "color" },
